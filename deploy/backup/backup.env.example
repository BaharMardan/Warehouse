# /etc/warehouse-backup/backup.env  (root:warehouse-backup, mode 640)
# The schema OWNER: DDL capture reads USER_* views and DBMS_METADATA.
ORACLE_USER=WAREHOUSE_LIVE
ORACLE_PASSWORD=change-me
# Local port forwarded to Ubuntu 1 by warehouse-backup-tunnel.service.
ORACLE_DSN=127.0.0.1:11521/FREEPDB1

BACKUP_DIR=/var/backups/warehouse
# Newest N archives are always kept.
KEEP_DAILY=30
# Plus the first archive of each of the last N months.
KEEP_MONTHLY=12
