# /etc/warehouse-backup/ssh_config
Host warehouse-oracle-backup
    HostName 192.168.1.31
    User parsa
    AddressFamily inet
    IdentityFile /etc/warehouse-backup/ssh_key
    IdentitiesOnly yes
    UserKnownHostsFile /etc/warehouse-backup/ssh_known_hosts
    StrictHostKeyChecking yes
    BatchMode yes
    ConnectTimeout 15
    ExitOnForwardFailure yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    LocalForward 127.0.0.1:11521 127.0.0.1:1521
