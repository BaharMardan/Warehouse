[Unit]
Description=Run the warehouse backup every day at 21:00 Tehran time

[Timer]
# The time zone is part of the schedule, so it is right whatever the VM clock zone is.
OnCalendar=*-*-* 21:00:00 Asia/Tehran
# If the VM was off at 21:00, run as soon as it is back.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
